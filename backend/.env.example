NODE_ENV=development
PORT=4000

# Local (non-Docker) default. When running via docker-compose, the backend
# container gets DATABASE_URL injected pointing at the "postgres" service instead.
DATABASE_URL=postgresql://biletflow:biletflow@localhost:5432/biletflow?schema=public
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
