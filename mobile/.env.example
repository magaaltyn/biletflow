# Address of the BiletFlow server as seen FROM THE PHONE (not "localhost" on a physical device!).
# The website (port 3000) forwards /api to the Express API, and also serves event and venue pictures.
#   Physical phone (same Wi-Fi):  http://<your-laptop-LAN-IP>:3000   e.g. http://192.168.1.76:3000
#   Android emulator:             http://10.0.2.2:3000
#   iOS simulator / Expo web:     http://localhost:3000
EXPO_PUBLIC_SERVER_URL=http://192.168.X.X:3000
# Optional: call the API directly instead of through the website, e.g. http://192.168.1.76:4000/api
EXPO_PUBLIC_API_URL=
