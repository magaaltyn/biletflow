# Copy to .env and fill in. Never commit .env.

# --- Local development (npm run dev) ---
DATABASE_URL=postgres://biletflow:biletflow@localhost:5432/biletflow
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
SMTP_HOST=localhost
SMTP_PORT=1025

# Long random strings in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me
QR_SECRET=change-me-too

# --- Google sign-in (optional) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: <WEB_URL>/api/auth/google/callback  e.g. http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Halyk ePay bank payments, TEST environment (optional) ---
# Public test credentials: https://epayment.kz/en-US/docs/Test-credentials
HALYK_ENABLED=false
HALYK_CLIENT_ID=
HALYK_CLIENT_SECRET=
HALYK_TERMINAL=
