# Root copy for reference. The backend reads backend/.env (created by scripts/setup.ps1 from backend/.env.example).
# Copy to backend/.env (the setup script does this automatically and generates secrets).
ENVIRONMENT=development
# Native run (backend on Windows, PostgreSQL in Docker on port 5433):
DATABASE_URL=postgresql+psycopg://biletflow:biletflow@localhost:5433/biletflow
TEST_DATABASE_URL=postgresql+psycopg://biletflow:biletflow@localhost:5433/biletflow_test
# Long random strings — never commit real values
SECRET_KEY=replace-with-a-long-random-string
QR_SIGNING_KEY=replace-with-another-long-random-string
ACCESS_TOKEN_MINUTES=720
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local email catcher (Mailpit). Inbox: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SENDER=BiletFlow <no-reply@biletflow.local>
EMAIL_ENABLED=true
RESERVATION_MINUTES=15
ACTIVATION_FEE_KZT=5000
